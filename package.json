{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "preinstall": "node tools/preinstall.mjs",
    "dev": "netlify dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "vitest run",
    "typecheck:libs": "tsc --build",
    "typecheck:functions": "tsc -p artifacts/api-server/netlify/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck && pnpm run typecheck:functions",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs"
  },
  "private": true,
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
